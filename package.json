{
  "name": "polymarket-terminal",
  "version": "1.0.0",
  "description": "Automated trading terminal for Polymarket — copy trades, market make, and snipe orderbooks from the command line",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "create-gnosis-safe": "node scripts/create-gnosis-safe.js",
    "transfer-to-safe": "node scripts/transfer-usdc-to-safe.js",
    "send-matic": "node scripts/send-matic.js",
    "start": "node src/index.js",
    "dev": "nodemon --ignore 'data/*.json' src/index.js",
    "mm": "cross-env DRY_RUN=false node src/mm.js",
    "mm-sim": "cross-env DRY_RUN=true node src/mm.js",
    "mm-sim-5m": "cross-env DRY_RUN=true MM_DURATION=5m node src/mm.js",
    "mm-sim-15m": "cross-env DRY_RUN=true MM_DURATION=15m node src/mm.js",
    "mm-dev": "cross-env DRY_RUN=true nodemon --ignore data/*.json src/mm.js",
    "sniper": "cross-env DRY_RUN=false node src/sniper.js",
    "sniper-sim": "cross-env DRY_RUN=true node src/sniper.js",
    "sniper-dev": "cross-env DRY_RUN=true nodemon --ignore data/*.json src/sniper.js"
  },
  "keywords": [
    "polymarket",
    "copy-trade",
    "crypto"
  ],
  "author": "direkturcrypto",
  "license": "ISC",
  "dependencies": {
    "@polymarket/builder-relayer-client": "^0.0.8",
    "@polymarket/builder-signing-sdk": "^0.0.8",
    "@polymarket/clob-client": "^4.7.3",
    "dotenv": "^16.4.7",
    "ethers": "^5.8.0",
    "viem": "^2.21.0",
    "ws": "^8.19.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.9"
  }
}
